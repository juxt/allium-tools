-- allium: 3
-- allium-check-tool-behaviour.allium
-- Scope: Standalone CLI behavior for running Allium checks outside VS Code.
-- Includes:
--   - CLI argument parsing and mode selection
--   - Input resolution for files, directories, and wildcard patterns
--   - Finding output format and exit code behavior
-- Excludes:
--   - VS Code editor integration and code actions
--   - Packaging/distribution details for npm or extension marketplaces
--
-- Each rule expresses its checkable core (which diagnostic code, at which
-- severity) as ensures. Conditions and guarantees Allium cannot express as
-- predicates are kept verbatim under @guidance; the classes are catalogued in
-- docs/capability-gaps.md.

value CheckMode {
    value: strict | relaxed
}

value CheckInput {
    value: file_path | directory_path | wildcard_pattern
}

entity CheckedFile {
    path: String
}

entity CheckRun {
    mode: CheckMode
    inputs: Set<CheckInput>
    files: Set<CheckedFile>
}

-- The checker's external stimuli: the commands and lifecycle events it reacts
-- to. Each is an entry point driven from outside the spec, not emitted by a
-- rule. Declared here so every rule that listens for one resolves its trigger.
surface CheckerCli {
    provides:
        CheckCommandInvoked(mode: CheckMode)
        CheckCommandInvokedWithInput(input: CheckInput)
        CheckCommandInvokedWithInputs(inputs)
        CheckCommandInvokedWithOptions(options)
        CheckCommandInvokedWithoutInputs()
        WorkspaceCommandInvoked(command)
        PreCommitWorkflowInvoked()
        CliPackageInstalledFromReleaseNpmArtifact()
        FileChecked(file: CheckedFile)
        CheckRunCompleted(run: CheckRun)
}

rule InvalidModeIsRejected {
    when: CheckCommandInvoked(mode)
    requires: mode not in [strict, relaxed]

    ensures: UsagePrinted()
    ensures: ProcessExit(code: 2)
}

rule MissingInputsAreRejected {
    when: CheckCommandInvokedWithoutInputs()

    ensures: UsagePrinted()
    ensures: ProcessExit(code: 2)
}

rule MissingResolvedFilesAreRejected {
    when: CheckCommandInvokedWithInputs(inputs)
    requires: ResolveAlliumFiles(inputs).is_empty = true

    ensures: UserInformed(message: "No .allium files found for the provided inputs.")
    ensures: ProcessExit(code: 2)
}

rule DirectoryInputExpandsToAlliumFiles {
    when: CheckCommandInvokedWithInput(input)
    requires: input.kind = directory_path
    ensures: ResolvedFilesAreRecursiveAlliumFiles()

    @guidance
        -- ensures: CheckRun.files includes input.recursive_files where file.extension = ".allium"
}

rule WildcardInputMatchesAlliumFiles {
    when: CheckCommandInvokedWithInput(input)
    requires: input.kind = wildcard_pattern
    ensures: ResolvedFilesMatchWildcardAlliumOnly()

    @guidance
        -- ensures: CheckRun.files includes file where MatchesWildcard(file.relative_path, input)
        -- ensures: CheckRun.files excludes file where file.extension != ".allium"
}

rule FindingsArePrintedPerFile {
    when: FileChecked(file)
    requires: file.findings.count > 0

    ensures: LinePrinted(format: "<path>:<line>:<character> <severity> <code> <message>")
}

rule NonInfoFindingsFailTheRun {
    when: CheckRunCompleted(run)
    requires: run.findings.any(f => f.severity in [error, warning])

    ensures: ProcessExit(code: 1)
}

rule InformationalOnlyFindingsSucceed {
    when: CheckRunCompleted(run)
    requires: run.findings.all(f => f.severity = info)

    ensures: LinePrinted(message: "No blocking findings.")
    ensures: ProcessExit(code: 0)
}

rule AutofixFlagAppliesSafeFixes {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: SafeFixApplied(kind: missing_ensures_scaffold)
    ensures: SafeFixApplied(kind: missing_when_scaffold)
    ensures: SafeFixApplied(kind: temporal_guard_scaffold)

    @guidance
        -- requires: command_args includes "--autofix"
}

rule FixCodeOptionScopesAutofixToSelectedDiagnosticCodes {
    when: CheckCommandInvokedWithOptions(options)

    ensures: SafeFixApplied(kind: missing_ensures_scaffold)
    ensures: SafeFixNotApplied(kind: temporal_guard_scaffold)

    @guidance
        -- requires: options includes "--autofix"
        -- requires: options includes "--fix-code allium.rule.missingEnsures"
}

rule AutofixWritesUpdatedSpecs {
    when: SafeFixApplied(kind)

    ensures: FileWritten(path: "<input>.allium")
    ensures: LinePrinted(message: "<path>: autofixed")
}

rule AutofixDryRunDoesNotWriteChanges {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: LinePrinted(message: "<path>: would autofix")
    ensures: FileUnchanged(path: "<input>.allium")

    @guidance
        -- requires: command_args includes "--autofix"
        -- requires: command_args includes "--dryrun"
}

rule WorkspaceCheckCommandDelegatesToChecker {
    when: WorkspaceCommandInvoked(command)

    ensures: CheckCommandInvokedWithInputs(inputs)
}

rule WatchModeReevaluatesInputsOnFileChanges {
    when: CheckCommandInvokedWithOptions(options)

    ensures: CheckRunRepeatedOnInputChange()

    @guidance
        -- requires: options includes "--watch"
}

rule ChangedFlagChecksModifiedAlliumFiles {
    when: CheckCommandInvokedWithOptions(options)

    ensures: ResolveAlliumFilesFromGitStatus()

    @guidance
        -- requires: options includes "--changed"
}

rule MinSeverityFiltersReportedFindings {
    when: CheckCommandInvokedWithOptions(options)
    ensures: FindingsBelowMinSeverityFilteredOut(severity: info)

    @guidance
        -- requires: options includes "--min-severity warning"
        -- ensures: FindingsWithSeverity(info) are_filtered_out
}

rule IgnoreCodeFiltersMatchingFindings {
    when: CheckCommandInvokedWithOptions(options)
    ensures: FindingsWithIgnoredCodeFilteredOut()

    @guidance
        -- requires: options includes "--ignore-code"
        -- ensures: FindingsWithCode(code) are_filtered_out
}

rule StatsOptionPrintsCountsByCode {
    when: CheckCommandInvokedWithOptions(options)

    ensures: FindingCountsPrintedGroupedByCode()

    @guidance
        -- requires: options includes "--stats"
}

rule FailOnThresholdControlsBlockingSeverity {
    when: CheckCommandInvokedWithOptions(options)
    ensures: BlockingSeverityControlledByFailOnThreshold()

    @guidance
        -- requires: options includes "--fail-on error"
        -- ensures: FindingsWithSeverity(warning) do_not_fail_process
        -- ensures: FindingsWithSeverity(error) fail_process
}

rule ReportOptionWritesRenderedOutputToPath {
    when: CheckCommandInvokedWithOptions(options)

    ensures: ReportFileWritten(path: options.report_path)

    @guidance
        -- requires: options includes "--report"
}

rule FixInteractivePromptsBeforeApplyingEachSafeFix {
    when: CheckCommandInvokedWithOptions(options)

    ensures: SafeFixPromptPrintedPerFix()
    ensures: SafeFixAppliedOnlyWhenAccepted()

    @guidance
        -- requires: options includes "--autofix"
        -- requires: options includes "--fix-interactive"
}

rule CacheOptionStoresAndReusesFindingsForUnchangedFiles {
    when: CheckCommandInvokedWithOptions(options)

    ensures: CacheFileWritten(path: ".allium-check-cache.json")
    ensures: UnchangedFilesReuseCachedFindings()

    @guidance
        -- requires: options includes "--cache"
}

rule ConfigFileCanProvideCheckDefaults {
    when: CheckCommandInvokedWithOptions(options)
    requires: FileExists(path: "allium-config-file")

    ensures: ConfigDefaultsLoaded(section: check)

    @guidance
        -- requires: options excludes "--no-config"
}

rule CheckCanUseProjectSpecPathsFromConfig {
    when: CheckCommandInvokedWithoutInputs()
    requires: FileExists(path: "allium-config-file")
    requires: ConfigContainsProjectSpecPaths()

    ensures: CheckCommandUsesConfiguredProjectSpecPaths()

    @guidance
        -- requires: command_args excludes "--no-config"
}

rule SpecDriftGateRunsInPreCommitWorkflow {
    when: PreCommitWorkflowInvoked()

    ensures: CommandInvoked(name: "npm run drift:check")
    ensures: CommitBlockedWhenDriftDetected()
}

rule ReleasedCliPackageExposesCheckCommand {
    when: CliPackageInstalledFromReleaseNpmArtifact()

    ensures: CommandAvailable(name: "allium-check")
}

rule StandaloneCheckerMatchesExtensionRuleSet {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.field.unused", severity: info)
    ensures: FindingObserved(code: "allium.rule.unreachableTrigger", severity: info)

    @guidance
        -- requires: inputs includes spec_file_with_known_informational_findings
}

-- Output ordering is a deterministic function of the input, independent of
-- process-level HashMap iteration order (#71). Diagnostics are ordered by
-- source position, then code.
rule DiagnosticsAreDeterministicallyOrdered {
    when: CheckCommandInvokedWithInputs(inputs)
    ensures: DiagnosticsOrderedBySourcePositionThenCode()

    @guidance
        -- ensures: diagnostics are ordered by source position then code
        -- ensures: the diagnostics array is identical across repeated runs on identical input
}

-- What counts as a reference for allium.field.unused. A field is used when it
-- is read via member access, populated by a creation, or named by a sibling
-- derived field on the same entity. Only a field never referenced any of these
-- ways is reported.

rule FieldReferencedBySiblingDerivedFieldIsUsed {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.field.unused", field: field)

    @guidance
        -- requires: entity declares field
        -- requires: another derived field on the same entity references field by bare name
}

rule FieldPopulatedByCreatedNamedArgumentIsUsed {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.field.unused", field: field)

    @guidance
        -- requires: entity declares field
        -- requires: a rule sets field via a named argument in Entity.created(field: value)
}

rule BareIdentifierElsewhereDoesNotSuppressUnusedField {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.field.unused", field: field, severity: info)

    @guidance
        -- requires: entity declares field never referenced on the entity
        -- requires: a rule binding or trigger parameter shares the field's name
}

-- Reachability passes descend into nested block bodies (if/else and for), not
-- just a rule's or surface's top-level clauses.

rule StatusAssignedInConditionalBranchIsReachable {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.status.unreachableValue", status: value)

    @guidance
        -- requires: entity declares status value
        -- requires: a rule assigns the status value in an ensures clause inside an if or else branch
}

rule TriggerProvidedInsideForBlockIsReachable {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.rule.unreachableTrigger", trigger: trigger)

    @guidance
        -- requires: a rule listens for trigger
        -- requires: a surface provides trigger inside a for block in its provides section
}

-- A becomes/transitions_to trigger fires with the entity already in its target
-- state, so that state is the start state of the transition the rule performs,
-- the same start state a requires guard would establish. Credited in the
-- entity's own module, not only across a use edge (#70). Splitting a spec into
-- modules therefore never yields fewer reports than the equivalent single file.
rule TransitionTriggerEstablishesStartStateLocally {
    when: CheckCommandInvokedWithInputs(inputs)
    ensures: FindingNotObserved(code: "allium.status.noExit", status: source)

    @guidance
        -- requires: a rule is triggered by a becomes or transitions_to trigger on a status value
        -- requires: the same rule assigns a different declared status value in its ensures
        -- ensures: the transition from the trigger's state to the assigned state is observed
        -- ensures: FindingNotObserved(code: "allium.status.noExit", status: the trigger's state)
}

rule CrossModuleReferenceSuppressesUnusedWarning {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.entity.unused", entity: entity_or_value)
    ensures: FindingNotObserved(code: "allium.definition.unused", definition: entity_or_value)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a declares entity_or_value
        -- requires: file_b references entity_or_value via qualified name (e.g. alias/Name)
        -- requires: file_b has use declaration mapping alias to file_a
}

rule UnresolvedUsePathWarnsInMultiFileMode {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.use.unresolvedPath", severity: warning)

    @guidance
        -- requires: file contains use declaration with path
        -- requires: path does not resolve to a file in the check set
        -- ensures: FindingMessage includes path
}

-- A use path has three states, not two. Resolved: a file in the check set.
-- Knowable but out of set: a local file present on disk (the single-file case,
-- checking one member of a pair) or a registry coordinate (github.com/org/spec/sha),
-- an immutable remote reference never expected on disk. Broken: a local .allium
-- path that resolves neither in the check set nor on disk. References through a
-- broken import are diagnosed per reference, independent of the use-line
-- unresolvedPath warning that a per-line allium-ignore can suppress (#87).

rule ReferenceThroughBrokenUsePathWarns {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.reference.unresolvedImport", severity: warning)

    @guidance
        -- requires: file references alias/Name where a use declaration binds alias
        -- requires: the alias's use path is a local .allium reference
        -- requires: the path resolves neither in the check set nor on disk
        -- ensures: FindingMessage names the reference and the unresolved path
        -- ensures: the finding survives a use-line allium-ignore of allium.use.unresolvedPath
}

rule ReferenceThroughKnowableOutOfSetImportStaysSilent {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.reference.unresolvedImport", name: Name)

    @guidance
        -- requires: file references alias/Name where a use declaration binds alias
        -- requires: the alias's use path is present on disk but outside the check set, or is a registry coordinate
}

rule QualifiedTriggerCallIsValidTriggerForm {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.rule.invalidTrigger")

    @guidance
        -- requires: rule when clause is qualified trigger call (e.g. alias/Trigger(params))
}

rule CrossModuleTriggerEmissionSatisfiesSubscription {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.rule.unreachableTrigger", trigger: trigger)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a provides or emits trigger
        -- requires: file_b listens for trigger, qualified via use alias mapping to file_a or unqualified
        -- requires: file_b has use declaration mapping alias to file_a
}

-- A rule emits a trigger through any bare call statement in its ensures block,
-- in any position and not only the first, and through an otherwise: emission on
-- a requires guard. Every such emission counts locally and exports to importers,
-- so a listener of a second-position, post-assignment, or otherwise: emission is
-- reachable and its qualified reference resolves (#88). Widening the emitted set
-- can also expose a real ambiguity the checker previously could not see, raising
-- allium.use.ambiguousReference where two imported modules both emit the trigger
-- and one did so after the first statement.

rule EmissionInAnyEnsuresPositionExports {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.rule.unreachableTrigger", trigger: trigger)
    ensures: FindingNotObserved(code: "allium.reference.unknownName", name: trigger)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a rule emits trigger as a bare call in any ensures position, or via an otherwise: clause
        -- requires: file_b listens for trigger qualified via use alias mapping to file_a
        -- requires: file_b has use declaration mapping alias to file_a
}

rule QualifiedTriggerUnreachableWhenAliasedModuleLacksIt {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.rule.unreachableTrigger", severity: info)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_b listens for trigger qualified via use alias mapping to file_a
        -- requires: file_a neither provides nor emits trigger
        -- ensures: FindingMessage names the imported module alias
}

rule QualifiedTriggerOutsideCheckSetNotFlagged {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.rule.unreachableTrigger", trigger: trigger)

    @guidance
        -- requires: file listens for trigger qualified via use alias
        -- requires: alias target does not resolve to a file in the check set
}

-- Reverse cross-module aggregation: #19 credits a listener's imports for
-- emitters (forward). These rules credit an importer's contributions back to
-- the module it imports (reverse), so a modular spec is analysed as the
-- equivalent merged single file would be. Crediting requires a real use import
-- edge; the imported module analysed alone keeps its local warnings.

rule QualifiedCreationCreditsImportedStatusLifecycle {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.status.unreachableValue", status: value)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a declares entity with status value
        -- requires: file_b has use declaration mapping alias to file_a
        -- requires: file_b assigns status value via qualified creation (e.g. alias/Entity.created(status: value))
}

rule QualifiedProvidesCreditsImportedTriggerReachability {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.rule.unreachableTrigger", trigger: trigger)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a rule listens for trigger
        -- requires: file_b has use declaration mapping alias to file_a
        -- requires: file_b surface provides trigger qualified via alias (e.g. alias/Trigger(params))
}

-- A qualified reference alias/Name at any site — a when trigger or entity
-- subject, a provides entry, a surface context, an inline parameter type, a
-- field type, a .created call, a default, a contract clause — must name a
-- module a use declaration binds. An undeclared alias is a locally-knowable
-- typo, diagnosed once at the reference by a single pass over every qualified
-- reference, single-file and multi-file alike (#72, #78 and the sites audit).

rule UndeclaredImportAliasIsDiagnosedAtEveryReferenceSite {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.reference.undefinedImportedAlias", severity: error)

    @guidance
        -- requires: a qualified reference alias/Name appears at any site
        -- requires: no use declaration in the module binds alias
        -- ensures: FindingMessage anchored at the reference names the unknown alias
}

-- Beyond the alias, the name itself must resolve: with a valid alias whose
-- target is in the check set, a qualified reference alias/Name where the aliased
-- module offers no such name is diagnosed at the reference. A module offers its
-- declared types, its referenced triggers, `config` when it declares a config
-- block, and each deferred declaration's root name (`deferred Foo` and
-- `deferred Foo.bar` both offer `Foo`). A foreign-qualified deferred names a
-- construct another module owns (`deferred other/Foo`) and is deliberately not
-- offered. Same unified pass, every site (#72, #89 and the name-existence
-- audit). A target outside the check set is unknowable.
--
-- One reference form is exempt: a name in a collection-consuming position
-- (a `for … in` / `in` / `where` iterable, or a `let` value) is an entity
-- collection, the pluralised form of an entity. The offered set holds declared
-- singular names, never the derived plural, and the checker has no
-- pluralisation model, so the membership test can neither confirm nor refute a
-- collection. It is left alone rather than flagged as unknown (#82). The alias
-- check still applies: an unknown alias on a collection is still an error.

rule UnknownImportedNameIsDiagnosedAtEveryReferenceSite {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.reference.unknownName", severity: warning)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: a qualified reference alias/Name where a use declaration binds alias to a file in the check set
        -- requires: the aliased module offers no name named Name (no declared type, referenced trigger, config block, or deferred root)
        -- requires: the reference is not in a collection-consuming position
        -- ensures: FindingMessage anchored at the reference names the unknown name
}

rule QualifiedNameOutsideCheckSetNotFlagged {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.reference.unknownName", name: Name)

    @guidance
        -- requires: a qualified reference alias/Name where alias's target is outside the check set
}

rule QualifiedCollectionReferenceNotFlagged {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.reference.unknownName", name: Name)

    @guidance
        -- requires: a qualified reference alias/Name in a collection-consuming position
        -- requires: a use declaration binds alias to a file in the check set
}

-- Config and deferred names resolve across the boundary. alias/config.param is
-- the documented config-reference form (a config default reading an imported
-- module's config value); alias/DeferredName names a deferred the module
-- declares. Both previously drew a false unknownName (#89).

rule QualifiedConfigReferenceResolves {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.reference.unknownName", name: config)

    @guidance
        -- requires: a qualified reference alias/config where a use declaration binds alias to a file in the check set
        -- requires: the aliased module declares a config block
}

rule QualifiedDeferredReferenceResolves {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.reference.unknownName", name: Name)

    @guidance
        -- requires: a qualified reference alias/Name where a use declaration binds alias to a file in the check set
        -- requires: the aliased module declares deferred Name, or deferred Name.field with root Name
}

-- Field-level resolution of alias/config.field is not yet implemented: the
-- qualified-reference node carries config, not the member chain, so a mistyped
-- config field is silent here rather than flagged. Chosen false negative;
-- config rules 46/47 (field existence, type) are a follow-up (#89).

rule QualifiedConfigFieldNotCheckedAtThisLayer {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.reference.unknownName", name: field)

    @guidance
        -- requires: a qualified reference alias/config.field where the aliased module declares a config block
        -- requires: the config block declares no parameter named field
}

rule WitnessedTransitionCreditsImportedLifecycle {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.status.unreachableValue", status: target)
    ensures: FindingNotObserved(code: "allium.status.noExit", status: source)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a declares entity with transition edge from source to target
        -- requires: file_a surface provides trigger with payload typed to entity
        -- requires: file_b has use declaration mapping alias to file_a
        -- requires: file_b rule subscribes to trigger qualified via alias, guards on source, assigns target
}

rule ImporterOwnedTriggerWitnessCreditsImportedLifecycle {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.status.unreachableValue", status: target)
    ensures: FindingNotObserved(code: "allium.status.noExit", status: source)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a declares entity with transition edge from source to target
        -- requires: file_b has use declaration mapping alias to file_a
        -- requires: file_b surface declares a context binding typed alias/entity and provides a trigger carrying it
        -- requires: file_b rule subscribes to that trigger, guards on source, assigns target
}

rule ImportedModuleAloneKeepsLocalLifecycleWarnings {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.status.unreachableValue", status: value, severity: warning)

    @guidance
        -- requires: inputs resolve to a single file
        -- requires: file declares status value assigned only by an importer outside the check set
}

rule CoSuppliedFilesWithoutImportEdgeDoNotContribute {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.status.unreachableValue", status: value, severity: warning)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: file_a declares entity with status value
        -- requires: file_b assigns status value but has no use declaration mapping to file_a
}

rule AmbiguousUnqualifiedNameReferenceWarns {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.use.ambiguousReference", severity: warning)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: two or more distinct imported files declare name
        -- requires: importing file references name unqualified
        -- requires: importing file does not declare name locally
        -- ensures: FindingMessage names the candidate import aliases
        -- ensures: FindingMessage suggests a qualified name
        -- ensures: at most one finding per ambiguous name, at its first reference site
}

rule AmbiguousUnqualifiedTriggerSubscriptionWarns {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.use.ambiguousReference", severity: warning)

    @guidance
        -- requires: inputs resolve to multiple files
        -- requires: two or more distinct imported files provide or emit trigger
        -- requires: importing file listens for trigger unqualified
        -- requires: importing file neither provides nor emits trigger locally
        -- ensures: FindingMessage names the candidate import aliases
        -- ensures: FindingMessage suggests a qualified name
}

rule AmbiguityResolvedByQualificationOrShadowing {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.use.ambiguousReference")

    @guidance
        -- requires: reference is qualified via use alias, or the importing file declares the name locally, or all matching use aliases target the same file
}

rule DeferredWithoutLocationHintWarns {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingObserved(code: "allium.deferred.missingLocationHint", severity: warning)

    @guidance
        -- requires: file contains deferred declaration
        -- requires: deferred line excludes quoted path, URL, and "-- see:" comment
}

rule DeferredWithLocationHintSuppressesWarning {
    when: CheckCommandInvokedWithInputs(inputs)

    ensures: FindingNotObserved(code: "allium.deferred.missingLocationHint", declaration: deferred_declaration)

    @guidance
        -- requires: file contains deferred_declaration
        -- requires: deferred_declaration line includes quoted path, URL, or "-- see:" comment
}

rule DeferredPathConstrainedToDottedName {
    when: CheckCommandInvokedWithInputs(inputs)
    -- accepted forms: Name, Name.field.sub, alias/Name, alias/Name.field,
    -- each optionally followed by a quoted location hint on the same line

    ensures: FindingObserved(severity: error)

    @guidance
        -- requires: file contains deferred_declaration
        -- requires: deferred_declaration path is not a dotted name with an optional use-alias qualifier
}
