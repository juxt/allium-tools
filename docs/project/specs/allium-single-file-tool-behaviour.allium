-- allium: 3
-- allium-single-file-tool-behaviour.allium
-- Scope: Standalone CLI behavior for the single-file commands that parse one
-- spec and print a JSON view of it: `plan`, `model` and `parse`.
-- Includes:
--   - Argument arity and input resolution
--   - The diagnostics channel carried in the JSON output
--   - Exit code behavior with respect to parse diagnostics
--   - The comparison output of `plan --against <path>`
--   - Obligation selection and the coverage output of `plan --covered-by <path>`
--   - The reduced outputs of `plan --summary` and `plan --compact`
-- Excludes:
--   - The multi-file commands `check` and `analyse` (see their own specs)
--   - The shape of the command-specific payload (obligations, domain model, AST)

value SingleFileCommand {
    value: plan | model | parse
}

entity SingleFileRun {
    command: SingleFileCommand
    input: String
    against: String?
    covered_by: String?
    -- the selector option values given to `plan`; empty when none is given
    selectors: Set<String>
    summary: Boolean
    compact: Boolean
}

-- The single-file commands' external stimuli. Declared so each listener
-- resolves its trigger, and the run it completes carries the run entity.
surface SingleFileCli {
    provides:
        SingleFileCommandInvoked(command, arguments)
        SingleFileCommandInvokedWithInput(input)
        PlanComparisonRequested(against)
        PlanIdListRequested(path)
        PlanSelectorsGiven(input, selectors)
        SingleFileRunCompleted(run: SingleFileRun)
}

-- The parser is error-tolerant: a spec that does not parse still yields a
-- partial module plus diagnostics rather than failing outright. The exit
-- code and the diagnostics channel are the only signals that distinguish a
-- parse failure from a spec that legitimately has nothing to report.

rule WrongArityIsRejected {
    when: SingleFileCommandInvoked(command, arguments)
    requires: command in [model, parse]
    requires: arguments.count != 1

    ensures: UsagePrinted()
    ensures: ProcessExit(code: 2)
}

-- `plan` accepts `<file>` plus any of the options `--against <path>`,
-- `--covered-by <path>`, `--id <id>`, `--id-prefix <prefix>`,
-- `--construct <name>`, `--category <name>` and `--ids-from <path>`, in any
-- order, each followed by exactly one value, and the flags `--summary` and
-- `--compact`, which take no value. Only the selector options (all but
-- `--against` and `--covered-by`) may repeat. Every other shape is a usage
-- error, among them: an option without a value, a second `--against` or
-- `--covered-by`, `--covered-by` together with `--against`, `-` as the value
-- of both `--covered-by` and `--ids-from`, and any two of `--against`,
-- `--covered-by`, `--summary` and `--compact` together.
rule PlanArgumentShapeIsRejected {
    when: SingleFileCommandInvoked(command, arguments)
    requires: command = plan
    requires: IsPlanArgumentShape(arguments: arguments, flags: ["--summary", "--compact"],
        mutually_exclusive: ["--against", "--covered-by", "--summary", "--compact"]) = false

    ensures: UsagePrinted()
    ensures: ProcessExit(code: 2)
}

rule MissingInputFileIsReported {
    when: SingleFileCommandInvokedWithInput(input)
    requires: ReadFile(input).ok = false

    ensures: UserInformed(message: "<path>: <io-error>")
    ensures: ProcessExit(code: 1)
}

rule BadComparisonInputIsReported {
    when: PlanComparisonRequested(against)
    requires: ReadFile(against).ok = false or IsJsonWithObligationIds(ReadFile(against).content) = false

    ensures: ComparisonInputErrorPrintedTo(stream: stderr)
    ensures: ProcessExit(code: 1)
}

-- With `--against`, the plan of `run.input` (new) is compared to the plan in
-- `run.against` (old), keyed by obligation `id`, ignoring every
-- `source_span`. `moved` pairs an
-- old-only id with a new-only id as `{from, to}` when their content is equal
-- apart from `id` and `source_span`; each id pairs at most once and then
-- leaves `removed` and `added`.
rule ComparisonReplacesPlan {
    when: SingleFileRunCompleted(run)
    requires: run.command = plan
    requires: run.against != null

    ensures: JsonKeysEmitted(keys: ["added", "removed", "changed", "moved", "diagnostics"])
    ensures: RemovedAreIdsOnlyInOldPlan(old: run.against, new: run.input)
    ensures: AddedAreIdsOnlyInNewPlan(old: run.against, new: run.input)
    ensures: ChangedAreSharedIdsWithDifferentContent(old: run.against, new: run.input)
    ensures: MovedArePairsFromOldOnlyIdToNewOnlyId(old: run.against, new: run.input)
    ensures: IdListsSorted()
}

-- `--covered-by` and `--ids-from` name a file of obligation ids, one per
-- line. Empty lines and surrounding whitespace are ignored; `-` reads stdin.
rule BadIdListInputIsReported {
    when: PlanIdListRequested(path)
    requires: ReadFile(path).ok = false

    ensures: IdListInputErrorPrintedTo(stream: stderr)
    ensures: ProcessExit(code: 1)
}

-- A selector value is unknown when it is an `--id` or `--ids-from` id that
-- is no obligation id of the plan of `input`, a `--construct` that no
-- obligation of that plan names as `source_construct`, or a `--category`
-- that no obligation of that plan carries. The plan of `--against` plays
-- no part. An `--id-prefix` that matches nothing is not an error.
rule UnknownSelectorValueIsReported {
    when: PlanSelectorsGiven(input, selectors)
    requires: UnknownSelectorValues(input: input, selectors: selectors).count > 0

    ensures: UnknownValuesPrintedTo(stream: stderr, values: UnknownSelectorValues(input: input, selectors: selectors))
    ensures: NothingPrintedTo(stream: stdout)
    ensures: ProcessExit(code: 1)
}

-- An obligation is selected when it matches any selector: its id equals an
-- `--id` or an `--ids-from` line, its id starts with an `--id-prefix`, its
-- `source_construct` equals a `--construct`, or its serialized category name
-- (for example `rule_failure`) equals a `--category`. Without a selector,
-- every obligation is selected. Selection filters the obligations before any
-- output: the plain output keeps its keys `version`, `obligations` and
-- `diagnostics`, and with `--against` both plans are filtered before the
-- comparison. Without any new option, the output of `plan` and of
-- `plan --against` is unchanged.
rule SelectionFiltersObligations {
    when: SingleFileRunCompleted(run)
    requires: run.command = plan

    ensures: ObligationsFilteredBeforeOutput(run: run, selectors: run.selectors)
}

-- `covered` holds the ids of `run.covered_by` that are selected obligation
-- ids of the plan of `run.input`; `uncovered` the selected obligation ids
-- missing from the file; `unknown` the ids of the file that are no
-- obligation id of that plan at all.
rule CoverageReplacesPlan {
    when: SingleFileRunCompleted(run)
    requires: run.command = plan
    requires: run.covered_by != null

    ensures: JsonKeysEmitted(keys: ["covered", "uncovered", "unknown", "diagnostics"])
    ensures: CoveredAreListedIdsThatAreSelected(list: run.covered_by, plan: run.input, selectors: run.selectors)
    ensures: UncoveredAreSelectedIdsNotListed(list: run.covered_by, plan: run.input, selectors: run.selectors)
    ensures: UnknownAreListedIdsNotInPlan(list: run.covered_by, plan: run.input)
    ensures: IdListsSorted()
    ensures: IdListsFreeOfDuplicates()
}

-- `--summary` and `--compact` reduce the output to the selected obligations.
-- Without them, every output of `plan`, including the full plan with its
-- keys `version`, `obligations` and `diagnostics`, is unchanged.
-- `by_category` is keyed by serialized category name (for example
-- `rule_failure`) and lists only categories with a selected obligation.
rule SummaryReplacesPlan {
    when: SingleFileRunCompleted(run)
    requires: run.command = plan
    requires: run.summary = true

    ensures: JsonKeysEmitted(keys: ["total", "by_category", "diagnostics"])
    ensures: TotalIsSelectedObligationCount(plan: run.input, selectors: run.selectors)
    ensures: ByCategoryCountsSelectedObligationsPerCategory(plan: run.input, selectors: run.selectors)
    ensures: ByCategoryKeysSorted()
}

-- With `--compact`, the plan keeps its usual keys and each selected
-- obligation carries only its `id`, `category` and `source_construct`.
rule CompactReducesObligations {
    when: SingleFileRunCompleted(run)
    requires: run.command = plan
    requires: run.compact = true

    ensures: JsonKeysEmitted(keys: ["version", "obligations", "diagnostics"])
    ensures: ObligationsCarryOnlyKeys(keys: ["id", "category", "source_construct"])
}

rule OutputCarriesDiagnostics {
    when: SingleFileRunCompleted(run)

    ensures: DiagnosticsArrayEmitted(source: run.input)
}

rule ParseErrorFailsTheRun {
    when: SingleFileRunCompleted(run)
    requires: run.diagnostics.any(d => d.severity = error)

    ensures: ProcessExit(code: 1)
}

rule NoParseErrorSucceeds {
    when: SingleFileRunCompleted(run)
    requires: run.diagnostics.all(d => d.severity in [info, warning])

    ensures: ProcessExit(code: 0)
}
