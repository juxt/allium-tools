-- allium: 3

entity Membership {
    status: active | expired | extended
    expires_at: Timestamp
    transitions status { active -> expired  active -> extended  terminal: expired, extended }
}

rule Create {
    when: NewMember()
    ensures: Membership.created(status: active)
}

rule AutoExpire {
    when: m: Membership.expires_at <= now
    requires: m.status = active
    ensures: m.status = expired
}

rule ManualExtend {
    when: AdminExtends(admin, membership: Membership)
    requires: membership.status = active
    ensures: membership.status = extended
}

surface Desk {
    provides:
        NewMember()
        AdminExtends(admin, membership: Membership)
}
