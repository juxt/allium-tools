-- allium: 3

entity Job {
    status: pending | done
    due_at: Timestamp
    transitions status { pending -> done  terminal: done }
}

rule CreateJob {
    when: JobRequested()
    ensures: Job.created(status: pending)
}

surface JobIntake {
    provides:
        JobRequested()
}

rule Witness {
    when: m: Job.due_at <= now
    requires: m.status = pending
    ensures: m.status = done
}
