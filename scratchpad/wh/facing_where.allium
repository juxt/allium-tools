-- allium: 3

entity Job {
    status: pending | done
    transitions status { pending -> done  terminal: done }
}

rule CreateJob {
    when: JobRequested()
    ensures: Job.created(status: pending)
}

surface JobIntake {
    provides:
        JobRequested()
}

surface WDesk {
    facing b: Job where status = pending
    provides:
        Ready(b)
            when b.status = pending
}
rule Witness {
    when: Ready(z)
    requires: z.status = pending
    ensures: z.status = done
}
