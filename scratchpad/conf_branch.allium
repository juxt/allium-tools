-- allium: 3

entity Membership {
    status: active | expired | extended
    expires_at: Timestamp
    transitions status {
        active -> expired
        active -> extended
        terminal: expired, extended
    }
}

rule AutoExpire {
    when: m: Membership.expires_at <= now
    requires: m.status = active
    ensures: m.status = expired
}

rule ManualExtend {
    when: AdminExtends(admin, membership, flag)
    requires: membership.status = active
    if flag:
        ensures: membership.status = extended
    else:
        ensures: membership.status = extended
}
